<div class="flex justify-end">
  <% items = [] %>
  <% items << { text: "New region", link: new_admin_region_path } %>
  <%= render "shared/dropdown_menu", items: items %>
</div>

<div class="flex flex-col my-6">
  <div class="-my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
    <div class="py-2 align-middle inline-block min-w-full sm:px-6 lg:px-8">
      <div class="shadow overflow-hidden border-b border-gray-200 sm:rounded-lg">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Id
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Name
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Main Cluster
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Clusters
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Bounds
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @regions.each do |region| %>
              <tr class="place-content-start align-top h-16">
                <td class="px-6 py-2 whitespace-nowrap">
                  <div class="text-sm text-gray-500">
                    <%= link_to region.id, edit_admin_region_path(region) %>
                  </div>
                </td>
                <td class="px-6 py-2 whitespace-nowrap">
                  <span class="text-sm text-gray-900 font-bold">
                    <%= link_to region.name, edit_admin_region_path(region) %>
                  </span>
                </td>
                <td class="px-6 py-2 whitespace-nowrap">
                  <span class="text-sm text-gray-500">
                    <%= region.main_cluster_id ? Cluster.find(region.main_cluster_id).name : "—" %>
                  </span>
                </td>
                <td class="px-6 py-2 whitespace-nowrap">
                  <span class="text-sm text-gray-500"><%= region.clusters.count %></span>
                </td>
                <td class="px-6 py-2 whitespace-nowrap">
                  <span class="text-sm text-gray-500">
                    <%= region.sw && region.ne ? "✓" : "—" %>
                  </span>
                </td>
                <td class="px-6 py-2 whitespace-nowrap"></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<p><%= "#{@regions.count} results" %></p>
