<% set_meta_tags title: t("views.areas.levels.metas.title") %>
<% set_meta_tags description: t("views.areas.levels.metas.description") %>
<% set_meta_tags og: { type: "website", image: image_url("hero-homepage.jpg") } %>

<div class="max-w-7xl mx-auto sm:px-6 lg:px-8 pt-6 pb-8">
  <nav class="flex mb-4 px-4 sm:px-0" aria-label="Breadcrumb">
    <ol role="list" class="flex items-center space-x-2">
      <li>
        <%= link_to regions_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" do %>
          <%= t("views.areas.levels.breadcrumbs.explore") %>
        <% end %>
      </li>
      <li>
        <div class="flex items-center">
          <svg class="h-5 w-5 flex-shrink-0 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M5.555 17.776l8-16 .894.448-8 16-.894-.448z" />
          </svg>
          <%= link_to @region.name, region_path(@region), class: "ml-2 text-sm font-medium text-gray-500 hover:text-gray-700" %>
        </div>
      </li>
    </ol>
  </nav>

  <h1 class="text-3xl font-bold mb-4 px-4 sm:px-0"><%= t("views.areas.levels.beginner_friendly") %></h1>

  <div class="lg:grid lg:grid-cols-2 lg:gap-16 mb-4">
    <div class="col-span-1">
      <div class="overflow-hidden bg-white shadow ring-1 ring-black ring-opacity-5 md:rounded-lg text-sm sm:text-base">
        <ul role="list" class="divide-y divide-gray-200">
          <% @beginner_areas.each do |area, count| %>
            <li>
              <%= link_to area_path(@region, @cluster, area), class: "block hover:bg-gray-50" do %>
                <div class="px-4 py-4 sm:px-6">
                  <div class="flex justify-between">
                    <p class="pr-2"><%= area.name %></p>
                    <div class="flex shrink-0 items-center space-x-2 text-gray-400">
                      <% cache area do %>
                        <span class="flex shrink-0"><%= render "shared/area_levels", area: area %></span>
                      <% end %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                      </svg>
                    </div>
                  </div>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
