<div class="col-span-6 sm:col-span-4">
  <%= form.label :name %>
  <%= form.text_field :name, autocomplete: "off" %>
</div>

<div class="col-span-6 sm:col-span-4">
  <%= form.label :main_cluster_id, "Main Cluster" %>
  <%= form.collection_select :main_cluster_id, Cluster.order(:name), :id, :name, { include_blank: "Select a cluster" } %>
</div>

<div class="col-span-6">
  <p class="text-sm text-gray-500">
    Use "Map edit" to set region bounds (southwest, northeast, center).
    You can draw a rectangle on the map and it will automatically calculate the bounds.
  </p>
</div>
