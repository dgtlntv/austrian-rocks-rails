<div class="col-span-6 sm:col-span-4">
  <%= form.label :published %>
  <%= form.check_box :published %>
</div>
<div class="col-span-6 sm:col-span-2"></div>

<div class="col-span-6 sm:col-span-4">
  <%= form.label :name %>
  <%= form.text_field :name, autocomplete: "off" %>
</div>

<div class="col-span-6 sm:col-span-4">
  <%= form.label :slug %>
  <%= form.text_field :slug, autocomplete: "off" %>
</div>

<div class="col-span-6 sm:col-span-4">
  <%= form.label :main_cluster_id, "Main Cluster" %>
  <%= form.collection_select :main_cluster_id, Cluster.order(:name), :id, :name, { include_blank: "Select a cluster" } %>
</div>

<div class="col-span-6 sm:col-span-4">
  <%= form.label :joined_tags, 'Tags' %>
  <%= form.text_field :joined_tags, value: @region.tags&.join(","), autocomplete: "off" %>
</div>

<div class="col-span-6 sm:col-span-4">
  <%= image_tag(@region.cover) if @region.cover&.persisted? %>
  <%= form.label :cover %>
  <%= form.file_field :cover %>
</div>

<div class="col-span-6">
  <p class="text-sm text-gray-500">
    Use "Map edit" to set region bounds (southwest, northeast, center).
    You can draw a rectangle on the map and it will automatically calculate the bounds.
  </p>
</div>
