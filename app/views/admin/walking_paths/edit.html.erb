<% add_breadcrumb "Walking paths", admin_walking_paths_path %>
<% add_breadcrumb "Walking path ##{@walking_path.id}", nil, class: "active" %>

<div class="flex justify-between items-center mb-6">
  <h1 class="my-3">Edit walking path</h1>
  <div class="flex space-x-3">
    <% if @walking_path.published? %>
      <%= button_to "Unpublish", unpublish_admin_walking_path_path(@walking_path), method: :patch, class: "btn" %>
    <% else %>
      <%= button_to "Publish", publish_admin_walking_path_path(@walking_path), method: :patch, class: "btn" %>
    <% end %>
    <%= button_to "Delete", admin_walking_path_path(@walking_path), method: :delete, class: "btn", form: { data: { turbo_confirm: "Delete this walking path?" } } %>
  </div>
</div>

<div class="mt-10 sm:mt-0">
  <div class="md:grid md:grid-cols-4 md:gap-6">
    <div class="mt-5 md:mt-0 md:col-span-3">
      <%= form_with model: [:admin, @walking_path], multipart: true do |form| %>
        <div class="shadow overflow-hidden sm:rounded-md">
          <div class="px-4 py-5 bg-white sm:p-6">
            <div class="grid grid-cols-6 gap-6">
              <%= render "form", form: form %>
            </div>
          </div>

          <div class="px-4 py-3 bg-gray-50 text-right sm:px-6">
            <button type="submit" class="btn">Update</button>
          </div>
        </div>
      <% end %>
    </div>

    <div class="md:col-span-1">
      <div class="px-4 sm:px-0"></div>
    </div>
  </div>
</div>
