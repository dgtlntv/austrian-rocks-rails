<% admin_area_breadcrumbs(@line.problem.area) %>
<% add_breadcrumb "Problem ##{@line.problem.id}", admin_problem_path(@line.problem) %>
<% add_breadcrumb "Line ##{@line.id}", nil, class: "active" %>

<div class="my-3">
  <%= link_to @line.problem.name_with_fallback, admin_problem_path(@line.problem) %>
</div>
<div class="my-3">
  <%= link_to "Topo ##{@line.topo.id}", edit_admin_topo_path(@line.topo) %>
</div>

<div data-controller="topo-editor">
  <div class="topo-editor-toolbar my-2" style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;">
    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="topo-editor#zoomOut">−</button>
    <span data-topo-editor-target="zoomLabel" style="min-width:4ch;text-align:center;">100%</span>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="topo-editor#zoomIn">+</button>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="topo-editor#reset">Fit</button>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="topo-editor#undo">Undo</button>
    <button type="button" class="btn btn-sm btn-outline-danger" data-action="topo-editor#clearAll">Clear</button>
    <small class="text-muted">Click to add · drag point to move · shift/right-click to delete · wheel/pinch to zoom · drag empty area to pan</small>
  </div>

  <div data-topo-editor-target="viewport"
       data-action="pointerdown->topo-editor#onPointerDown pointermove->topo-editor#onPointerMove pointerup->topo-editor#onPointerUp pointercancel->topo-editor#onPointerUp wheel->topo-editor#onWheel contextmenu->topo-editor#onContextMenu"
       style="position:relative;width:100%;height:70vh;overflow:hidden;background:#222;touch-action:none;user-select:none;cursor:crosshair;">
    <div data-topo-editor-target="wrapper" style="position:absolute;top:0;left:0;transform-origin:0 0;will-change:transform;">
      <%= cdn_image_tag(@line.topo.photo.variant(:medium), data: { "topo-editor-target": "image" }, style: "position:absolute;top:0;left:0;pointer-events:none;user-select:none;") %>
      <canvas data-topo-editor-target="canvas" style="position:absolute;top:0;left:0;pointer-events:none;"></canvas>
    </div>
  </div>

  <div class="my-3">
    <%= form_with model: [:admin, @line], data: { "topo-editor-target": "form" } do |form| %>
      <div class="my-3">
        <%= form.label :coordinates %>
        <%= form.text_area :coordinates, rows: "4", data: { "topo-editor-target": 'textarea' }, value: @line.coordinates.to_json %>
      </div>

      <div class="my-3">
        <%= form.submit "Save", class: "btn" %>
        <% items = [] %>
        <% items << { text: "Replace photo", link: replace_photo_admin_line_path(@line) } %>
        <% items << { text: "Destroy", link: admin_line_path(@line), data: { "turbo-confirm": 'Are you sure?', "turbo-method": :delete } } %>
        <%= render 'shared/dot_menu', items: items, align_class: "bottom-0" %>
      </div>
    <% end %>
  </div>
</div>

<div style="margin-bottom: 300px"></div>
