<% add_breadcrumb "Exports", nil, class: "active" %>

<h1 class="text-2xl font-bold text-gray-900 mb-6">Exports</h1>

<div class="bg-white shadow sm:rounded-lg mb-8">
  <div class="px-4 py-5 sm:px-6">
    <h2 class="text-lg font-medium text-gray-900">Global Exports</h2>
    <p class="mt-1 text-sm text-gray-500">Download pre-built exports with no configuration needed.</p>
  </div>
  <div class="border-t border-gray-200">
    <ul class="divide-y divide-gray-200">
      <li class="px-4 py-4 sm:px-6 flex items-center justify-between">
        <div>
          <span class="text-sm font-medium text-gray-900">SQLite Database</span>
          <span class="ml-2 text-sm text-gray-500"><%= BRAND_CONFIG[:slug] %>.db</span>
        </div>
        <%= link_to "Download", db_admin_exports_path(format: :db), class: "inline-flex items-center px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-white bg-brand-600 hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500" %>
      </li>
    </ul>
  </div>
</div>

<div class="bg-white shadow sm:rounded-lg">
  <div class="px-4 py-5 sm:px-6 flex items-start justify-between gap-4">
    <div>
      <h2 class="text-lg font-medium text-gray-900">PMTiles publishing</h2>
      <p class="mt-1 text-sm text-gray-500">Build, smoke-check, and publish the current map tile archive in the background.</p>
    </div>
    <%= button_to "Publish now", publish_pmtiles_admin_exports_path, method: :post, data: { turbo_confirm: "Build, smoke-check, and publish PMTiles now?" }, class: "inline-flex items-center px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-white bg-brand-600 hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500" %>
  </div>

  <div class="border-t border-gray-200 px-4 py-5 sm:px-6">
    <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <dt class="text-sm font-medium text-gray-500">Current status</dt>
        <dd class="mt-1">
          <span class="<%= map_tile_status_badge_class(@map_tile_state.current_status) %>"><%= map_tile_status_label(@map_tile_state.current_status) %></span>
        </dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Last source change</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= map_tile_timestamp(@map_tile_state.last_source_change_at) %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Pending automatic publish</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= map_tile_timestamp(@pending_automatic_attempt&.scheduled_for) %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Last successful publish</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= map_tile_timestamp(@last_successful_attempt&.finished_at) %></dd>
      </div>
    </dl>
  </div>

  <div class="border-t border-gray-200 px-4 py-5 sm:px-6">
    <h3 class="text-base font-medium text-gray-900 mb-4">Last successful publish</h3>
    <% if @last_successful_attempt.present? %>
      <dl class="grid grid-cols-1 gap-x-4 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <dt class="text-sm font-medium text-gray-500">Version</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @last_successful_attempt.version.presence || "—" %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">PMTiles URL</dt>
          <dd class="mt-1 text-sm"><%= map_tile_external_link(@last_successful_attempt.pmtiles_url, label: "PMTiles") %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Manifest URL</dt>
          <dd class="mt-1 text-sm"><%= map_tile_external_link(@last_successful_attempt.manifest_url, label: "Manifest") %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Duration</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= map_tile_duration(@last_successful_attempt.duration) %></dd>
        </div>
      </dl>
    <% else %>
      <p class="text-sm text-gray-500">No successful PMTiles publish has been recorded yet.</p>
    <% end %>
  </div>

  <div class="border-t border-gray-200 px-4 py-5 sm:px-6">
    <h3 class="text-base font-medium text-gray-900 mb-4">Recent PMTiles publish history</h3>
    <% if @recent_map_tile_attempts.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-3 py-2 text-left font-medium text-gray-500">Created</th>
              <th scope="col" class="px-3 py-2 text-left font-medium text-gray-500">Source</th>
              <th scope="col" class="px-3 py-2 text-left font-medium text-gray-500">Status</th>
              <th scope="col" class="px-3 py-2 text-left font-medium text-gray-500">Reason</th>
              <th scope="col" class="px-3 py-2 text-left font-medium text-gray-500">Version</th>
              <th scope="col" class="px-3 py-2 text-left font-medium text-gray-500">Started</th>
              <th scope="col" class="px-3 py-2 text-left font-medium text-gray-500">Finished</th>
              <th scope="col" class="px-3 py-2 text-left font-medium text-gray-500">Duration</th>
              <th scope="col" class="px-3 py-2 text-left font-medium text-gray-500">Links</th>
              <th scope="col" class="px-3 py-2 text-left font-medium text-gray-500">Error</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @recent_map_tile_attempts.each do |attempt| %>
              <tr>
                <td class="px-3 py-2 whitespace-nowrap text-gray-700"><%= map_tile_timestamp(attempt.created_at) %></td>
                <td class="px-3 py-2 whitespace-nowrap text-gray-700"><%= attempt.source %></td>
                <td class="px-3 py-2 whitespace-nowrap"><span class="<%= map_tile_status_badge_class(attempt.status) %>"><%= attempt.status %></span></td>
                <td class="px-3 py-2 text-gray-700"><%= attempt.trigger_reason.presence || "—" %></td>
                <td class="px-3 py-2 whitespace-nowrap text-gray-700"><%= attempt.version.presence || "—" %></td>
                <td class="px-3 py-2 whitespace-nowrap text-gray-700"><%= map_tile_timestamp(attempt.started_at) %></td>
                <td class="px-3 py-2 whitespace-nowrap text-gray-700"><%= map_tile_timestamp(attempt.finished_at) %></td>
                <td class="px-3 py-2 whitespace-nowrap text-gray-700"><%= map_tile_duration(attempt.duration) %></td>
                <td class="px-3 py-2 whitespace-nowrap text-gray-700">
                  <%= map_tile_external_link(attempt.pmtiles_url, label: "PMTiles") %>
                  <span class="mx-1 text-gray-300">/</span>
                  <%= map_tile_external_link(attempt.manifest_url, label: "Manifest") %>
                </td>
                <td class="px-3 py-2 text-gray-700"><%= map_tile_safe_error_text(attempt) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">No PMTiles publish attempts have been recorded yet.</p>
    <% end %>
  </div>
</div>
