<div class="col-span-6 sm:col-span-4">
  <%= form.label :published %>
  <%= form.check_box :published %>
</div>
<div class="col-span-6 sm:col-span-2"></div>

<div class="col-span-6 sm:col-span-4">
  <%= form.label :name %>
  <%= form.text_field :name, autocomplete: "off" %>
</div>

<div class="col-span-6 sm:col-span-4">
  <%= form.label :slug %>
  <%= form.text_field :slug, autocomplete: "off" %>
</div>

<div class="col-span-6 sm:col-span-4">
  <%= form.label :region_id, "Region" %>
  <%= form.collection_select :region_id, Region.order(:name), :id, :name, { include_blank: true } %>
</div>

<div class="col-span-6 sm:col-span-4">
  <%= form.label :main_area_id, "Main Area" %>
  <%= form.collection_select :main_area_id, Area.order(:name), :id, :name, { include_blank: "Select an area" } %>
</div>

<div class="col-span-6 sm:col-span-4">
  <%= form.label :joined_tags, 'Tags' %>
  <%= form.text_field :joined_tags, value: @cluster.tags&.join(","), autocomplete: "off" %>
</div>

<div class="col-span-6 sm:col-span-6">
  <%= form.label :warning_de %>
  <%= form.text_area :warning_de, rows: 3 %>
</div>

<div class="col-span-6 sm:col-span-6">
  <%= form.label :warning_en %>
  <%= form.text_area :warning_en, rows: 3 %>
</div>

<div class="col-span-6 sm:col-span-4">
  <%= form.label :guidebook_id, "Guidebook" %>
  <%= form.collection_select :guidebook_id, Guidebook.order(:title), :id, :title, { include_blank: true } %>
</div>

<div class="col-span-6 sm:col-span-4">
  <%= form.label :parking_poi_id, "Parking POI" %>
  <%= form.collection_select :parking_poi_id, Poi.parking.order(:name), :id, :name, { include_blank: true } %>
</div>

<div class="col-span-6 sm:col-span-4">
  <%= image_tag(@cluster.cover) if @cluster.cover&.persisted? %>
  <%= form.label :cover %>
  <%= form.file_field :cover %>
</div>

<div class="col-span-6">
  <p class="text-sm text-gray-500">
    Use "Map edit" to set cluster bounds (southwest, northeast, center).
    You can draw a rectangle on the map and it will automatically calculate the bounds.
  </p>
</div>
